# 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요:  cp .env.example .env
# 키가 없어도 파이프라인은 동작합니다(해당 소스/기능은 건너뛰거나 오프라인 폴백).

# --- 수집 소스 ---
# 11번가 오픈API 키 (판매자 계정 → 오픈API 서비스 등록 → 발급)
ELEVENST_API_KEY=여기에_발급받은_키_입력

# 네이버 오픈API (쇼핑 검색). developers.naver.com 에서 앱 등록 후 발급.
# 스마트스토어 '경쟁 시세'는 이 쇼핑 검색 API로 우회 수집합니다(PLATFORM_PLAN.md §1-3).
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- AI (상세페이지·CS) : 없으면 오프라인 템플릿/플레이스홀더로 동작 ---
# 텍스트 LLM: Claude (권장)
ANTHROPIC_API_KEY=
# 이미지(nano banana) + Gemini 텍스트: GEMINI_API_KEY 또는 GOOGLE_API_KEY
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# (선택) 모델 오버라이드
# CHANSTORE_TEXT_MODEL=claude-opus-4-8
# CHANSTORE_IMAGE_MODEL=gemini-2.5-flash-image
